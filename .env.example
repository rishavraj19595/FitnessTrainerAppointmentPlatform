# Database URL (PostgreSQL - Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitpulse?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="fitpulse-production-super-secret-key-32chars"

# Razorpay Configuration (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_fitpulseDemoKeyId123"
RAZORPAY_KEY_SECRET="fitpulseDemoKeySecretXYZ456"

# Resend Email Configuration (Optional / fallback to console log in dev)
RESEND_API_KEY="re_mock_test_key_123456789"
EMAIL_FROM="FitPulse <notifications@fitpulse.com>"

# Cloudinary / Supabase Storage (Optional for file uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="secret123"

# Node Environment
NODE_ENV="development"
